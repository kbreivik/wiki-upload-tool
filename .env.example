# Wiki.js API Configuration
# Copy this file to .env and fill in your values

# Required: Your Wiki.js API key
# Create at: Wiki.js Admin > API Access > Create API Key
WIKIJS_API_KEY=your-api-key-here

# Required: Wiki.js base URL (no trailing slash)
WIKIJS_URL=https://wiki.example.com

# Required: Base path for pages in Wiki.js (e.g., Documentation/MyProject)
WIKIJS_BASE_PATH=Documentation/MyProject

# Required: Local directory containing .md files to upload
WIKIJS_SOURCE_DIR=./docs

# Optional: Wiki.js locale (default: en)
WIKIJS_LOCALE=en
